{"default":{"identifier":"default","description":"Capabilities for the main Jarvis window. Note that Jarvis's own #[tauri::command] functions are not listed here: in Tauri v2 the ACL governs plugin commands (the core:, shell:, http:, fs: namespaces below), while commands registered through generate_handler are reachable without an entry. Everything here is therefore a plugin permission.","local":true,"windows":["main"],"permissions":["core:default","core:window:allow-start-dragging","core:window:allow-minimize","core:window:allow-maximize","core:window:allow-unmaximize","core:window:allow-close","core:window:allow-hide","core:window:allow-show","core:window:allow-set-focus","core:window:allow-is-visible","core:window:allow-is-maximized","core:event:default","core:app:default","core:path:default","shell:default","shell:allow-open","shell:allow-execute","http:default","http:allow-fetch","http:allow-fetch-cancel","http:allow-fetch-read-body","http:allow-fetch-send","fs:default","fs:allow-read","fs:allow-read-file","fs:allow-read-text-file","fs:allow-write","fs:allow-write-file","fs:allow-write-text-file","fs:allow-read-dir","fs:allow-mkdir","fs:allow-exists","fs:allow-stat","store:default","dialog:default","notification:default","os:default","process:default","clipboard-manager:default","clipboard-manager:allow-read-text","clipboard-manager:allow-write-text","global-shortcut:default","global-shortcut:allow-register","global-shortcut:allow-unregister","global-shortcut:allow-unregister-all"],"platforms":["linux","windows","macOS"]}}