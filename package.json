{
  "name": "aria",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ARIA — Adaptive Reasoning and Intelligence Assistant",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "cap:sync": "npm run build && cap sync",
    "android:open": "npm run cap:sync && cap open android",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug bundleRelease",
    "ios:open": "npm run cap:sync && cap open ios",
    "models:download": "bash scripts/download-models.sh"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^6.0.0",
