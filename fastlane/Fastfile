# Fastlane lanes for publishing Jarvis to the Play Store and TestFlight.
#
# Both platforms authenticate from environment variables so that nothing
# sensitive is committed. In CI those come from repository secrets; locally,
# export them yourself or put them in a gitignored `.env`.
#
#   Android:  GOOGLE_PLAY_JSON_KEY (service-account JSON, base64 or a path)
#             JARVIS_KEYSTORE_PATH / _PASSWORD, JARVIS_KEY_ALIAS / _PASSWORD
#
#   iOS:      APPSTORE_KEY_ID, APPSTORE_ISSUER_ID, APPSTORE_PRIVATE_KEY
#
# Usage:  fastlane android beta   |   fastlane ios beta

skip_docs
opt_out_usage

APP_IDENTIFIER = 'ai.jarvis.assistant'

# ── Android ────────────────────────────────────────────────────────

platform :android do
  desc 'Build the web assets and sync them into the Android project'
  private_lane :prepare do
    sh('cd .. && npm ci && npm run cap:sync')
  end

  desc 'Write the Play service-account key to a temp file and return its path'
  private_lane :play_key_path do
    raw = ENV['GOOGLE_PLAY_JSON_KEY']
    UI.user_error!('GOOGLE_PLAY_JSON_KEY is not set') if raw.to_s.empty?

    # Accept either a path to the file or the JSON itself, base64 or plain —
    # CI secrets get stored all three ways in practice.
    if File.exist?(raw)
      raw
    else
      json = raw.strip.start_with?('{') ? raw : Base64.decode64(raw)
      path = File.join(Dir.tmpdir, 'play-service-account.json')
      File.write(path, json)
      path
    end
  end

  desc 'Build a signed AAB and upload it to the Play Store internal track'
  lane :beta do
    prepare

    gradle(project_dir: 'android', task: 'clean')
    gradle(
      project_dir: 'android',
      task: 'bundle',
      build_type: 'Release',
      print_command: false
    )

    upload_to_play_store(
      package_name: APP_IDENTIFIER,
      json_key: play_key_path,
      track: 'internal',
      aab: 'android/app/build/outputs/bundle/release/app-release.aab',
      release_status: 'draft',
      # The listing is managed in the Play Console, not from here.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    UI.success('Uploaded to the Play Store internal track as a draft.')
  end

  desc 'Promote the current internal build to production'
  lane :promote do
    upload_to_play_store(
      package_name: APP_IDENTIFIER,
      json_key: play_key_path,
      track: 'internal',
      track_promote_to: 'production',
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc 'Build a sideloadable debug APK'
  lane :apk do
    prepare
    gradle(project_dir: 'android', task: 'assemble', build_type: 'Debug')
    UI.success('APK: android/app/build/outputs/apk/debug/app-debug.apk')
  end
end

# ── iOS ────────────────────────────────────────────────────────────

platform :ios do
  desc 'Build the web assets and sync them into the iOS project'
  private_lane :prepare do
    sh('cd .. && npm ci && npm run cap:sync')
    cocoapods(podfile: 'ios/App/Podfile', try_repo_update_on_error: true)
  end

  desc 'Authenticate against App Store Connect with an API key'
  private_lane :authenticate do
    app_store_connect_api_key(
      key_id: ENV.fetch('APPSTORE_KEY_ID'),
      issuer_id: ENV.fetch('APPSTORE_ISSUER_ID'),
      key_content: ENV.fetch('APPSTORE_PRIVATE_KEY'),
      # The key arrives base64-encoded from CI secrets.
      is_key_content_base64: !ENV.fetch('APPSTORE_PRIVATE_KEY').include?('BEGIN PRIVATE KEY'),
      in_house: false
    )
  end

  desc 'Build and upload a build to TestFlight'
  lane :beta do
    authenticate
    prepare

    # Derive the build number from the CI run so every upload is unique;
    # App Store Connect rejects a repeat.
    build_number = ENV['GITHUB_RUN_NUMBER'] || Time.now.strftime('%Y%m%d%H%M')
    increment_build_number(
      xcodeproj: 'ios/App/App.xcodeproj',
      build_number: build_number
    )

    sync_code_signing(
      type: 'appstore',
      app_identifier: APP_IDENTIFIER,
      readonly: is_ci
    )

    build_app(
      workspace: 'ios/App/App.xcworkspace',
      scheme: 'App',
      configuration: 'Release',
      export_method: 'app-store',
      output_directory: 'build/ios',
      output_name: 'Jarvis.ipa',
      clean: true
    )

    upload_to_testflight(
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      # Compliance is declared in Info.plist via ITSAppUsesNonExemptEncryption.
      skip_submission: true
    )

    UI.success('Uploaded to TestFlight.')
  end

  desc 'Submit the latest TestFlight build for App Store review'
  lane :release do
    authenticate
    deliver(
      app_identifier: APP_IDENTIFIER,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      precheck_include_in_app_purchases: false
    )
  end
end
