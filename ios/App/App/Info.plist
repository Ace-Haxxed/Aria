<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Jarvis</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Jarvis is dark-theme only; forcing the style stops iOS from flashing
	     a light status bar and keyboard over the app. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<!-- Permission prompts. iOS rejects a build that uses these APIs without
	     a usage string, and the text is what the user actually reads. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Jarvis uses the microphone so you can speak your requests instead of typing them. Audio is only captured while you are holding the orb or after the wake word.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Jarvis converts your speech to text so it can understand what you are asking for.</string>
	<key>NSCameraUsageDescription</key>
	<string>Jarvis uses the camera when you ask it to look at something and tell you what it is.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Jarvis can analyse a photo from your library when you choose one to ask about.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Jarvis saves images to your photo library when you ask it to.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>ai.jarvis.assistant.ask</string>
	</array>

	<!-- Background modes: audio keeps wake-word listening alive, and fetch
	     lets scheduled reminders fire while the app is suspended. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>ai.jarvis.assistant.refresh</string>
	</array>

	<!-- Deep link: jarvis://chat?message=... -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.jarvis.assistant</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jarvis</string>
			</array>
		</dict>
	</array>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
